# X-06: 环境变量配置说明 —— 复制为 .env 后按需修改

# === 基础 ===
BAIZE_HOST=0.0.0.0
BAIZE_PORT=9877
BAIZE_DATA_DIR=~/.baize

# === 模型 ===
BAIZE_MODEL_CONFIG=~/.baize/models.json
BAIZE_AUTH_DB=~/.baize/auth.db
BAIZE_DEFAULT_PROVIDER=openai
BAIZE_DEFAULT_MODEL=gpt-4o

# === 执行器 ===
BAIZE_EXEC_BACKEND=local
BAIZE_EXEC_SANDBOX=danger_full_access
# BAIZE_EXEC_IMAGE=instrumentisto/nmap

# === 编排 ===
BAIZE_ORCH_MAX_PARALLEL=3
BAIZE_BLACKBOARD_MAX_NODES=5000

# === 日志 (B-21) ===
BAIZE_LOG_FORMAT=text
# BAIZE_LOG_FILE=/var/log/baize/baize.log
BAIZE_LOG_MAX_BYTES=10485760
BAIZE_LOG_BACKUP_COUNT=5
BAIZE_LOG_LEVEL=INFO

# === 限流 (X-01) ===
BAIZE_RATE_LIMIT=60

# === 安全 ===
# BAIZE_PRINT_TOKENS=1  # 启动时在 stdout 打印密码/令牌（仅调试用）
